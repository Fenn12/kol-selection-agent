# 复制为 .env 后填写。.env 已在 .gitignore 中，不会被提交。
# 环境变量优先于本文件（部署环境不会被覆盖）

# ---- 大模型（OpenAI 兼容接口，DeepSeek 官方即可）----
DEEPSEEK_API_KEY=sk-在这里填你的key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
MODEL=deepseek-chat

# ---- 数据源（可选，默认 csv）----
# KOL_DATASOURCE=sql
# KOL_DB_URL=mysql://reader:pass@10.0.0.12:3306/marketing
# KOL_DB_MODULE=my_pkg.kol_db

# ---- 第三方达人数据（可选，不填走 mock）----
# KOL_TP_PROVIDER=feigua
# KOL_TP_BASE=https://your-gateway/feigua
# KOL_TP_TOKEN=

# ---- 企业微信（可选）----
# WECOM_BOT_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=

# ---- 飞书多维表格（可选）----
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_BITABLE_APP_TOKEN=
# FEISHU_BITABLE_TABLE_ID=

# ---- 邮件推送（可选）----
# KOL_SMTP_HOST=smtp.exmail.qq.com
# KOL_SMTP_PORT=465
# KOL_SMTP_USER=
# KOL_SMTP_PASS=
# KOL_MAIL_TO=
