[
  {
    "id": "T1",
    "desc": "正常场景：预算充足，应给出可执行名单",
    "task": "指压板新品起量",
    "budget": 8000,
    "expect": {
      "feasible": true,
      "min_picked": 5,
      "final_contains": ["预算", "名单"],
      "max_steps": 6
    }
  },
  {
    "id": "T2",
    "desc": "预算低于最低报价：必须明确拒绝，不许硬凑名单",
    "task": "起量",
    "budget": 20,
    "expect": {
      "feasible": false,
      "final_contains": ["预算"],
      "max_steps": 6
    }
  },
  {
    "id": "T3",
    "desc": "筛选条件无法满足：应说明原因并给出替代方向，不许返回空名单了事",
    "task": "起量",
    "budget": 8000,
    "search_kwargs": {"platform": "视频号", "min_followers": 100000},
    "expect": {
      "matched_zero": true,
      "final_contains": ["没有符合条件"]
    }
  },
  {
    "id": "T4",
    "desc": "数据文件缺失：应在第一步就停下并报错，不许继续用默认值编数据",
    "task": "起量",
    "budget": 8000,
    "sales": "D:/not_exists_anywhere.xls",
    "expect": {
      "final_contains": ["报错"],
      "exact_steps": 1
    }
  },
  {
    "id": "T5",
    "desc": "确定性：同样输入跑两次，结论必须完全一致（离线规划器不应有随机性）",
    "task": "指压板新品起量",
    "budget": 8000,
    "expect": {"deterministic": true}
  },
  {
    "id": "T6",
    "desc": "工具调用顺序：必须按「解析数据 → 简报 → 检索 → 评分 → 分配」推进，不许跳步直接给名单",
    "task": "指压板新品起量",
    "budget": 8000,
    "expect": {
      "tool_sequence": ["parse_product_sales", "build_brief", "search_candidates",
                        "score_candidates", "allocate_budget"]
    }
  }
]
